# ava — example environment. Copy to .env and adjust.
# Vars use the AVA_ prefix.

# HTTP listen address
AVA_ADDR=:8080

# Log level: debug | info | warn | error
AVA_LOG_LEVEL=info

# SQLite database file (XDG data location; runs in-process with ":memory:")
AVA_DB=${XDG_DATA_HOME:-$HOME/.local/share}/ava/ava.db

# Master key for the encrypted secret vault.
#   32 bytes as 64 hex chars: openssl rand -hex 32
#   required, stable across restarts — a different key cannot open stored secrets
AVA_SECRETS_MASTER_KEY=

# Access token for the web UI login — exchanged for an HttpOnly session
# cookie. Any random string works as a bearer secret, e.g. openssl rand -hex 32
AVA_UI_TOKEN=
