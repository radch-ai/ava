# ava — example environment. Copy to .env and adjust.
# Vars use the AVA_ prefix.

# HTTP listen address
AVA_ADDR=:8080

# Log level: debug | info | warn | error
AVA_LOG_LEVEL=info

# SQLite database file (XDG data location; runs in-process with ":memory:")
AVA_DB=${XDG_DATA_HOME:-$HOME/.local/share}/ava/ava.db

# Master key for the encrypted secret vault.
#   32 bytes as 64 hex chars: openssl rand -hex 32
#   required, stable across restarts — a different key cannot open stored secrets
AVA_SECRETS_MASTER_KEY=

# Access token for the web UI login — exchanged for an HttpOnly session
# cookie. Any random string works as a bearer secret, e.g. openssl rand -hex 32
AVA_UI_TOKEN=
# Tool execution capacity. Optional advanced overrides — unset values use
# the built-in defaults (4 concurrent executions per MCP server, 16 across
# the whole process including builtins). Excess calls wait within their
# invocation deadline instead of failing. Values must be positive; a
# malformed or non-positive value fails boot.
# AVA_MCP_CONCURRENCY_PER_SERVER=4
# AVA_TOOL_CONCURRENCY_GLOBAL=16
#
# Context-window catalog source. Unset fetches the models.dev snapshot at
# boot (cached beside the database, refreshed at most daily); a model's
# window resolves from its declared entry, a limit learned from an
# overflow error, this catalog, then the provider's own live listing —
# never a guess. Set but empty disables refresh and uses the embedded
# snapshot alone.
# AVA_MODEL_CATALOG_URL=https://models.dev/api.json
#
# Fixed by the turn engine, not configurable: 32 tool attempts per turn
# (denials included) — the model cannot raise its own ceiling.
