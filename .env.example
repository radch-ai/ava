# --- Backend & Gateway (shared) ---

# Required: Zitadel instance URL for OAuth token introspection
ZITADEL_DOMAIN=https://your-zitadel-instance.zitadel.cloud
# Required: Path to application key JSON file for Private Key JWT auth
ZITADEL_INTROSPECTOR_PRIVATE_KEY_PATH=/path/to/key.json
# Required: PostgreSQL connection URL
DATABASE_URL=postgres://user:password@localhost:5432/ava?sslmode=disable

# --- Backend ---

# Server bind address
# Default: :8080
BACKEND_ADDR=:8080
# Log level (debug, info, warn, error)
# Default: info
BACKEND_LOG_LEVEL=info
# Required: Signing key for Zitadel Actions v2 webhook signature verification
ZITADEL_WEBHOOK_SIGNING_KEY=your-webhook-signing-key

# --- Gateway ---

# Server bind address
# Default: :8080
GATEWAY_ADDR=:8080
# Log level (debug, info, warn, error)
# Default: info
GATEWAY_LOG_LEVEL=info
# Max concurrent WebSocket connections
# Default: 10000
GATEWAY_MAX_CONNS=10000
# Required: Bifrost LLM gateway URL
BIFROST_BASEURL=http://localhost:8080/v1
# Required: Redis server address (user config store, quota system)
REDIS_ADDR=localhost:6379
# Required: Redis password
REDIS_PASSWORD=
