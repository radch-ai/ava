# Server configuration
# Default: :8080
ADDR=:8080
# Default: info
LOG_LEVEL=info
# Required: Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Zitadel configuration
# Required: Zitadel instance URL
ZITADEL_DOMAIN=https://your-zitadel-instance.zitadel.cloud
# Required: Path to application key JSON file for Private Key JWT auth
ZITADEL_INTROSPECTOR_PRIVATE_KEY_PATH=/path/to/key.json
# Required: Signing key for Zitadel Actions v2 webhook signature verification
ZITADEL_WEBHOOK_SIGNING_KEY=your-webhook-signing-key

# Database
# Required: PostgreSQL connection URL
DATABASE_URL=postgres://user:password@localhost:5432/ava?sslmode=disable
