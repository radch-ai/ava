{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ava",
  "version": "0.1.0",
  "identifier": "ai.radch.ava",
  "build": {
    "beforeDevCommand": {
      "script": "bun run dev",
      "cwd": "ui"
    },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": {
      "script": "bun run build",
      "cwd": "ui"
    },
    "frontendDist": "ui/build"
  },
  "app": {
    "windows": [
      {
        "title": "ava",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "default",
          "description": "Capability for the main window",
          "windows": ["main"],
          "permissions": [
            "core:default",
            "opener:default"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
