#!/bin/bash
# Pre-commit hook: format Go code and run linter on staged files
# Install: make install-hooks

set -e

# Find staged Go files
GO_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' || true)

if [ -z "$GO_FILES" ]; then
    exit 0
fi

echo "Running pre-commit checks on staged Go files..."

# Format code
echo "Formatting..."
echo "$GO_FILES" | xargs gofmt -w
echo "$GO_FILES" | xargs goimports -w 2>/dev/null || true

# Add formatted files back to staging
echo "$GO_FILES" | xargs git add

# Lint
echo "Linting..."
golangci-lint run ./... --timeout=5m

echo "Pre-commit checks passed."
