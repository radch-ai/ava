# Docker-specific (not in .gitignore)
*Dockerfile*
.dockerignore
.gitignore
docker-compose*.yml

# --- Below mirrors .gitignore ---

.DS_Store
.env
.env.*
!.env.example

# Rust workspace
# Generated by Cargo
# will have compiled files and executables
/target/

# Go module
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/

# sqlc-generated query layer (regenerate via `just sqlc-generate`)
services/*/internal/db/

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov
