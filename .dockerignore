# Docker-specific (not in .gitignore)
*Dockerfile*
.dockerignore
.gitignore
docker-compose*.yml

# Monorepo paths unused by Go service image builds
ui/
Cargo.toml
Cargo.lock
.github/
justfile
AGENTS.md
.env.example

# Per-service noise (tests/docs/assets not needed to compile)
services/*/tests/
services/*/docs/
services/*/Makefile
services/*/README.md
services/*/models.json
services/*/.claude/

# --- Below mirrors .gitignore ---

.DS_Store
.env
.env.*
!.env.example

# Rust workspace
# Generated by Cargo
# will have compiled files and executables
/target/

# Go module
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/

# sqlc-generated query layer (regenerate via `just sqlc-generate`)
services/*/internal/db/

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov
