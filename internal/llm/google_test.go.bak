// Package llm provides Google Gemini API integration for the agent runtime.
package llm

import (
	"context"
	"encoding/json"
	"net/http"
	"net/http/httptest"
	"strings"
	"testing"
	"time"

	"github.com/nevaria-ai/gateway/internal/agent"
)

// TestGoogleClient_Stream_TextOnly tests streaming a simple text response.
func TestGoogleClient_Stream_TextOnly(t *testing.T) {
	t.Parallel()

	// Create a mock server that returns a streaming response
	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		// Verify request
		if r.Method != http.MethodPost {
			t.Errorf("expected POST request, got %s", r.Method)
		}
		if !strings.Contains(r.URL.Path, "models") {
			t.Errorf("expected path to contain 'models', got %s", r.URL.Path)
		}

		// Verify API key in query parameter
		if !strings.Contains(r.URL.RawQuery, "key=test-key") {
			t.Errorf("expected API key in query, got %s", r.URL.RawQuery)
		}

		// Set headers for SSE
		w.Header().Set("Content-Type", "text/event-stream")
		w.Header().Set("Cache-Control", "no-cache")
		w.Header().Set("Connection", "keep-alive")

		// Write SSE events
		flusher, _ := w.(http.Flusher)
		events := []string{
			"data: {\"candidates\": [{\"content\": {\"parts\": [{\"text\": \"Hello\"}], \"role\": \"model\"}}]}\n\n",
			"data: {\"candidates\": [{\"content\": {\"parts\": [{\"text\": \" world\"}], \"role\": \"model\"}}]}\n\n",
			"data: {\"candidates\": [{\"content\": {\"parts\": [{\"text\": \"!\"}], \"role\": \"model\"}}], \"usageMetadata\": {\"totalTokenCount\": 10}}\n\n",
			"data: [DONE]\n\n",
		}
		for _, event := range events {
			w.Write([]byte(event))
			flusher.Flush()
		}
	}))
	defer server.Close()

	// Create client
	client := &googleClient{
		apiKey:  "test-key",
		baseURL: server.URL,
		model:   agent.Model{ID: "gemini-2.0-flash-exp"},
		timeout: int(DefaultTimeout.Seconds()),
		httpClient: &http.Client{Timeout: 100 * time.Millisecond}, // Short timeout for test
	}

	// Create messages
	messages := []agent.AgentMessage{
		agent.NewTextMessage(agent.RoleUser, "Say hello"),
	}

	// Stream
	ctx := context.Background()
	eventCh, err := client.Stream(ctx, messages, nil)
	if err != nil {
		t.Fatalf("Stream() failed: %v", err)
	}

	// Collect events
	var events []agent.AgentEvent
	for event := range eventCh {
		events = append(events, event)
	}

	// Verify events
	if len(events) < 3 {
		t.Errorf("expected at least 3 events, got %d", len(events))
	}

	// Check for MessageStartEvent
	startFound := false
	updateCount := 0
	endFound := false
	var fullText string

	for _, event := range events {
		switch e := event.(type) {
		case agent.MessageStartEvent:
			startFound = true
		case agent.MessageUpdateEvent:
			updateCount++
			fullText += e.Delta
		case agent.MessageEndEvent:
			endFound = true
		}
	}

	if !startFound {
		t.Error("MessageStartEvent not found")
	}
	if updateCount == 0 {
		t.Error("No MessageUpdateEvent found")
	}
	if !endFound {
		t.Error("MessageEndEvent not found")
	}
	if fullText != "Hello world!" {
		t.Errorf("expected full text 'Hello world!', got %q", fullText)
	}
}

// TestGoogleClient_Stream_ToolCall tests streaming with tool calls.
func TestGoogleClient_Stream_ToolCall(t *testing.T) {
	t.Parallel()

	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		w.Header().Set("Content-Type", "text/event-stream")
		w.Header().Set("Cache-Control", "no-cache")
		w.Header().Set("Connection", "keep-alive")

		flusher, _ := w.(http.Flusher)

		// Send a tool call response
		toolCallData := map[string]any{
			"candidates": []map[string]any{
				{
					"content": map[string]any{
						"parts": []map[string]any{
							{
								"functionCall": map[string]any{
									"name": "calculator",
									"args": map[string]any{
										"operation": "add",
										"x":         5,
										"y":         3,
									},
								},
							},
						},
						"role": "model",
					},
				},
			},
		}
		jsonData, _ := json.Marshal(toolCallData)

		events := []string{
			"data: " + string(jsonData) + "\n\n",
			"data: [DONE]\n\n",
		}
		for _, event := range events {
			w.Write([]byte(event))
			flusher.Flush()
		}
	}))
	defer server.Close()

	client := &googleClient{
		apiKey:  "test-key",
		baseURL: server.URL,
		model:   agent.Model{ID: "gemini-2.5-pro"},
		timeout: int(DefaultTimeout.Seconds()),
	}

	messages := []agent.AgentMessage{
		agent.NewTextMessage(agent.RoleUser, "Calculate 5 + 3"),
	}

	tools := []agent.Tool{
		{
			Name:        "calculator",
			Description: "Performs calculations",
		},
	}

	ctx := context.Background()
	eventCh, err := client.Stream(ctx, messages, tools)
	if err != nil {
		t.Fatalf("Stream() failed: %v", err)
	}

	var endEvent *agent.MessageEndEvent
	for event := range eventCh {
		if e, ok := event.(agent.MessageEndEvent); ok {
			endEvent = &e
			break
		}
	}

	if endEvent == nil {
		t.Fatal("MessageEndEvent not found")
	}

	// Verify tool call
	if len(endEvent.Message.Content) == 0 {
		t.Fatal("Expected content in message")
	}

	toolCall, ok := endEvent.Message.Content[0].(agent.ToolCallContent)
	if !ok {
		t.Fatalf("expected ToolCallContent, got %T", endEvent.Message.Content[0])
	}

	if toolCall.Name != "calculator" {
		t.Errorf("expected tool name 'calculator', got %q", toolCall.Name)
	}
	if toolCall.ID == "" {
		t.Error("expected tool call ID")
	}
}

// TestGoogleClient_Stream_ContextCancellation tests context cancellation.
func TestGoogleClient_Stream_ContextCancellation(t *testing.T) {
	t.Parallel()

	blockChan := make(chan struct{})
	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		w.Header().Set("Content-Type", "text/event-stream")
		flusher, _ := w.(http.Flusher)
		<-blockChan // Block until test finishes
		flusher.Flush()
	}))
	defer server.Close()
	defer close(blockChan)

	client := &googleClient{
		apiKey:  "test-key",
		baseURL: server.URL,
		model:   agent.Model{ID: "gemini-2.0-flash-exp"},
		timeout: int(DefaultTimeout.Seconds()),
		httpClient: &http.Client{Timeout: 100 * time.Millisecond}, // Short timeout for test
	}

	messages := []agent.AgentMessage{
		agent.NewTextMessage(agent.RoleUser, "Hello"),
	}

	ctx, cancel := context.WithCancel(context.Background())
	eventCh, err := client.Stream(ctx, messages, nil)
	if err != nil {
		t.Fatalf("Stream() failed: %v", err)
	}

	// Cancel context after a short delay to allow request to start
	time.AfterFunc(10*time.Millisecond, func() {
		cancel()
	})

	// Channel should close
	_, more := <-eventCh
	if more {
		t.Error("expected channel to close after context cancellation")
	}
}

// TestGoogleClient_Stream_HTTPError tests HTTP error handling.
func TestGoogleClient_Stream_HTTPError(t *testing.T) {
	t.Parallel()

	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		w.WriteHeader(http.StatusUnauthorized)
		w.Write([]byte(`{"error": {"message": "Invalid API key"}}`))
	}))
	defer server.Close()

	client := &googleClient{
		apiKey:  "invalid-key",
		baseURL: server.URL,
		model:   agent.Model{ID: "gemini-2.0-flash-exp"},
		timeout: int(DefaultTimeout.Seconds()),
	}

	messages := []agent.AgentMessage{
		agent.NewTextMessage(agent.RoleUser, "Hello"),
	}

	ctx := context.Background()
	_, err := client.Stream(ctx, messages, nil)
	if err == nil {
		t.Error("expected error for invalid API key, got nil")
	}
}

// TestGoogleClient_Stream_MultiPartText tests streaming with multipart text.
func TestGoogleClient_Stream_MultiPartText(t *testing.T) {
	t.Parallel()

	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		w.Header().Set("Content-Type", "text/event-stream")
		flusher, _ := w.(http.Flusher)

		// Send multiple parts in one response
		data := map[string]any{
			"candidates": []map[string]any{
				{
					"content": map[string]any{
						"parts": []map[string]any{
							{"text": "Part 1"},
							{"text": " Part 2"},
							{"text": " Part 3"},
						},
						"role": "model",
					},
				},
			},
		}
		jsonData, _ := json.Marshal(data)

		events := []string{
			"data: " + string(jsonData) + "\n\n",
			"data: [DONE]\n\n",
		}
		for _, event := range events {
			w.Write([]byte(event))
			flusher.Flush()
		}
	}))
	defer server.Close()

	client := &googleClient{
		apiKey:  "test-key",
		baseURL: server.URL,
		model:   agent.Model{ID: "gemini-2.5-flash"},
		timeout: int(DefaultTimeout.Seconds()),
	}

	messages := []agent.AgentMessage{
		agent.NewTextMessage(agent.RoleUser, "Tell me a story"),
	}

	ctx := context.Background()
	eventCh, err := client.Stream(ctx, messages, nil)
	if err != nil {
		t.Fatalf("Stream() failed: %v", err)
	}

	var fullText string
	for event := range eventCh {
		if e, ok := event.(agent.MessageUpdateEvent); ok {
			fullText += e.Delta
		}
	}

	expected := "Part 1 Part 2 Part 3"
	if fullText != expected {
		t.Errorf("expected %q, got %q", expected, fullText)
	}
}

// TestGoogleClient_MessagesToGoogleFormat tests message conversion.
func TestGoogleClient_MessagesToGoogleFormat(t *testing.T) {
	t.Parallel()

	tests := []struct {
		name     string
		messages []agent.AgentMessage
		wantRole string
	}{
		{
			name: "user message",
			messages: []agent.AgentMessage{
				agent.NewTextMessage(agent.RoleUser, "Hello"),
			},
			wantRole: "user",
		},
		{
			name: "assistant message",
			messages: []agent.AgentMessage{
				agent.NewTextMessage(agent.RoleAssistant, "Hi there!"),
			},
			wantRole: "model",
		},
		{
			name: "tool result message",
			messages: []agent.AgentMessage{
				agent.NewToolResultMessage("call-123", "calculator", "8", false),
			},
			wantRole: "function",
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			client := &googleClient{
				apiKey: "test-key",
				model:  agent.Model{ID: "gemini-2.0-flash-exp"},
			}

			googleMsgs := client.messagesToGoogleFormat(tt.messages)
			if len(googleMsgs) == 0 {
				t.Fatal("expected at least one message")
			}

			if googleMsgs[0].Role != tt.wantRole {
				t.Errorf("expected role %q, got %q", tt.wantRole, googleMsgs[0].Role)
			}
		})
	}
}

// TestGoogleClient_ToolsToGoogleFormat tests tool conversion.
func TestGoogleClient_ToolsToGoogleFormat(t *testing.T) {
	t.Parallel()

	tools := []agent.Tool{
		{
			Name:        "calculator",
			Description: "Performs mathematical calculations",
		},
		{
			Name:        "weather",
			Description: "Gets current weather for a location",
		},
	}

	client := &googleClient{
		apiKey: "test-key",
		model:  agent.Model{ID: "gemini-2.5-pro"},
	}

	googleDecls := client.toolsToGoogleFormat(tools)

	if len(googleDecls) != 2 {
		t.Fatalf("expected 2 tool declarations, got %d", len(googleDecls))
	}

	if googleDecls[0].Function.Name != "calculator" {
		t.Errorf("expected tool name 'calculator', got %q", googleDecls[0].Function.Name)
	}
	if googleDecls[0].Function.Description != "Performs mathematical calculations" {
		t.Errorf("unexpected description: %q", googleDecls[0].Function.Description)
	}
}

// TestGoogleClient_Stream_Timeout tests request timeout.
func TestGoogleClient_Stream_Timeout(t *testing.T) {
	t.Parallel()

	blockChan := make(chan struct{})
	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		<-blockChan
	}))
	defer server.Close()
	defer close(blockChan)

	client := &googleClient{
		apiKey:     "test-key",
		baseURL:    server.URL,
		model:      agent.Model{ID: "gemini-2.0-flash-exp"},
		httpClient: &http.Client{Timeout: 10 * time.Millisecond},
	}

	messages := []agent.AgentMessage{
		agent.NewTextMessage(agent.RoleUser, "Hello"),
	}

	ctx := context.Background()
	_, err := client.Stream(ctx, messages, nil)
	if err == nil {
		t.Error("expected timeout error, got nil")
	}
}

// TestGoogleClient_VerifyRequestBody tests that the request body is correctly formatted.
func TestGoogleClient_VerifyRequestBody(t *testing.T) {
	t.Parallel()

	var receivedBody map[string]json.RawMessage

	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		// Parse request body
		if err := json.NewDecoder(r.Body).Decode(&receivedBody); err != nil {
			t.Fatalf("failed to decode request body: %v", err)
		}

		// Verify required fields
		if _, ok := receivedBody["contents"]; !ok {
			t.Error("request body missing 'contents' field")
		}

		// Send minimal response
		w.Header().Set("Content-Type", "text/event-stream")
		w.Write([]byte("data: [DONE]\n\n"))
	}))
	defer server.Close()

	client := &googleClient{
		apiKey: "test-key",
		baseURL: server.URL,
		model:  agent.Model{ID: "gemini-2.0-flash-exp"},
	}

	messages := []agent.AgentMessage{
		agent.NewTextMessage(agent.RoleUser, "Hello"),
	}

	tools := []agent.Tool{
		{
			Name:        "test_tool",
			Description: "A test tool",
		},
	}

	ctx := context.Background()
	eventCh, err := client.Stream(ctx, messages, tools)
	if err != nil {
		t.Fatalf("Stream() failed: %v", err)
	}

	// Consume channel to complete the request
	for range eventCh {
	}

	// Verify the request was received
	if receivedBody == nil {
		t.Fatal("request body was not received")
	}
}
