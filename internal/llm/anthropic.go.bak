// Package llm provides Anthropic LLM client implementation.
package llm

import (
	"bufio"
	"context"
	"encoding/json"
	"fmt"
	"io"
	"net/http"
	"strings"
	"time"

	"github.com/nevaria-ai/gateway/internal/agent"
)

// AnthropicClientConfig holds configuration for the Anthropic client.
type AnthropicClientConfig struct {
	APIKey        string
	BaseURL       string
	Model         string
	Timeout       time.Duration
	ThinkingLevel agent.ThinkingLevel
}

// AnthropicClient is the Anthropic provider implementation.
type AnthropicClient struct {
	config        AnthropicClientConfig
	httpClient    *http.Client
	model         agent.Model
}

// NewAnthropicClient creates a new Anthropic client.
func NewAnthropicClient(config AnthropicClientConfig) *AnthropicClient {
	if config.Timeout == 0 {
		config.Timeout = DefaultTimeout
	}

	// Set default base URL if not provided
	baseURL := config.BaseURL
	if baseURL == "" {
		baseURL = "https://api.anthropic.com"
	}

	return &AnthropicClient{
		config: config,
		httpClient: &http.Client{
			Timeout: config.Timeout,
		},
		model: agent.Model{
			ID:       config.Model,
			Provider: "anthropic",
		},
	}
}

// Stream sends messages to the Anthropic API and returns a channel of events.
func (c *AnthropicClient) Stream(ctx context.Context, messages []agent.AgentMessage, tools []agent.Tool) (<-chan agent.AgentEvent, error) {
	reqBody := anthropicMessagesRequest{
		Model:     c.config.Model,
		MaxTokens: 4096,
		Messages:  c.convertMessagesToAnthropic(messages),
		Tools:     c.convertToolsToAnthropic(tools),
		Stream:    true,
	}

	// Add thinking if enabled
	thinking := c.convertThinkingLevel()
	if thinking != nil {
		reqBody.Thinking = thinking
	}

	reqJSON, err := json.Marshal(reqBody)
	if err != nil {
		return nil, fmt.Errorf("failed to marshal request: %w", err)
	}

	baseURL := c.config.BaseURL
	if baseURL == "" {
		baseURL = "https://api.anthropic.com"
	}
	url := baseURL + "/v1/messages"

	req, err := http.NewRequestWithContext(ctx, http.MethodPost, url, strings.NewReader(string(reqJSON)))
	if err != nil {
		return nil, fmt.Errorf("failed to create request: %w", err)
	}

	req.Header.Set("Content-Type", "application/json")
	req.Header.Set("x-api-key", c.config.APIKey)
	req.Header.Set("anthropic-version", "2023-06-01")

	resp, err := c.httpClient.Do(req)
	if err != nil {
		return nil, fmt.Errorf("request failed: %w", err)
	}

	if resp.StatusCode != http.StatusOK {
		body, _ := io.ReadAll(resp.Body)
		resp.Body.Close()
		return nil, fmt.Errorf("API returned status %d: %s", resp.StatusCode, string(body))
	}

	return c.parseAnthropicStream(ctx, resp.Body)
}

// convertMessagesToAnthropic converts agent messages to Anthropic format.
func (c *AnthropicClient) convertMessagesToAnthropic(messages []agent.AgentMessage) []anthropicToolFormatFormat {
	result := make([]anthropicToolFormatFormat, 0, len(messages))

	for _, msg := range messages {
		anthropicMsg := anthropicMessageFormat{
			Role:    string(msg.Role),
			Content: c.convertContentToAnthropic(msg),
		}

		// Handle tool result messages
		if msg.Role == agent.RoleToolResult {
			anthropicMsg.Role = "user"
			toolResultContent := map[string]any{
				"type":        "tool_result",
				"tool_use_id": msg.ToolCallID,
				"content":     msg.IsError,
			}

			// Extract text content if present
			if len(msg.Content) > 0 {
				if tc, ok := msg.Content[0].(agent.TextContent); ok {
					toolResultContent["content"] = tc.Text
					toolResultContent["is_error"] = msg.IsError
				}
			}

			anthropicMsg.Content = []any{toolResultContent}
		}

		result = append(result, anthropicMsg)
	}

	return result
}

// convertContentToAnthropic converts agent content blocks to Anthropic format.
func (c *AnthropicClient) convertContentToAnthropic(msg agent.AgentMessage) []any {
	result := make([]any, 0, len(msg.Content))

	for _, block := range msg.Content {
		switch b := block.(type) {
		case agent.TextContent:
			result = append(result, map[string]any{
				"type": "text",
				"text": b.Text,
			})
		case agent.ImageContent:
			result = append(result, map[string]any{
				"type": "image",
				"source": map[string]any{
					"type":      "base64",
					"media_type": b.MimeType,
					"data":      b.Data,
				},
			})
		case agent.ToolCallContent:
			result = append(result, map[string]any{
				"type":  "tool_use",
				"id":    b.ID,
				"name":  b.Name,
				"input": b.Arguments,
			})
		}
	}

	return result
}

// convertToolsToAnthropic converts agent tools to Anthropic tool format.
func (c *AnthropicClient) convertToolsToAnthropic(tools []agent.Tool) []anthropicToolFormat {
	// Convert using ToAnthropicTools then convert InputSchema to map
	toolsFromPackage := ToAnthropicTools(tools)
	result := make([]anthropicToolFormat, len(toolsFromPackage))
	for i, tool := range toolsFromPackage {
		result[i] = anthropicToolFormat{
			Name:        tool.Name,
			Description: tool.Description,
			InputSchema: map[string]any{
				"type":       "object",
				"properties": make(map[string]any),
			},
		}
	}
	return result
}

// convertThinkingLevel converts the thinking level to Anthropic's thinking config.
func (c *AnthropicClient) convertThinkingLevel() *anthropicThinkingFormatFormat {
	if c.config.ThinkingLevel.IsOff() {
		return nil
	}

	budget := 0
	switch c.config.ThinkingLevel {
	case agent.ThinkingLevelMinimal:
		budget = 1000
	case agent.ThinkingLevelLow:
		budget = 3000
	case agent.ThinkingLevelMedium:
		budget = 12000
	case agent.ThinkingLevelHigh:
		budget = 24000
	}

	return &anthropicThinking{
		Type:         "enabled",
		BudgetTokens: budget,
	}
}

// parseAnthropicStream parses the SSE stream from Anthropic.
func (c *AnthropicClient) parseAnthropicStream(ctx context.Context, body io.ReadCloser) (<-chan agent.AgentEvent, error) {
	eventCh := make(chan agent.AgentEvent, 100)

	go func() {
		defer close(eventCh)
		defer body.Close()

		scanner := bufio.NewScanner(body)

		var currentMessage *agent.AgentMessage
		var currentText strings.Builder
		var currentBlocks []agent.ContentBlock
		var toolUseBuffer *anthropicToolUseBuffer
		timestamp := time.Now().Unix()

		// Emit turn start
		eventCh <- agent.TurnStartEvent{Timestamp: timestamp}

		for scanner.Scan() {
			select {
			case <-ctx.Done():
				return
			default:
			}

			line := scanner.Text()

			// Skip empty lines and comments
			if line == "" || strings.HasPrefix(line, ":") {
				continue
			}

			// Parse SSE format
			if !strings.HasPrefix(line, "event:") && !strings.HasPrefix(line, "data:") {
				continue
			}

			if strings.HasPrefix(line, "event:") {
				continue // We only care about data lines
			}

			// Parse data line
			dataLine := strings.TrimPrefix(line, "data:")
			dataLine = strings.TrimSpace(dataLine)

			if dataLine == "[DONE]" {
				break
			}

			var event map[string]any
			if err := json.Unmarshal([]byte(dataLine), &event); err != nil {
				continue
			}

		eventType, _ := event["type"].(string)

			switch eventType {
			case "message_start":
				currentMessage = &agent.AgentMessage{
					Role:    agent.RoleAssistant,
					Content: []agent.ContentBlock{},
				}
				eventCh <- agent.MessageStartEvent{
					Timestamp: timestamp,
					Message:   *currentMessage,
				}

			case "content_block_start":
				contentBlock := event["content_block"].(map[string]any)
				blockType, _ := contentBlock["type"].(string)

				if blockType == "tool_use" {
					toolUseBuffer = &anthropicToolUseBuffer{
						ID:       contentBlock["id"].(string),
						Name:     contentBlock["name"].(string),
						Arguments: make(map[string]any),
					}
				} else if blockType == "text" {
					currentText.Reset()
				}

			case "content_block_delta":
				delta := event["delta"].(map[string]any)
				deltaType, _ := delta["type"].(string)

				if deltaType == "text_delta" {
					text, _ := delta["text"].(string)
					currentText.WriteString(text)

					eventCh <- agent.MessageUpdateEvent{
						Timestamp: timestamp,
						Message: agent.AgentMessage{
							Role:    agent.RoleAssistant,
							Content: []agent.ContentBlock{agent.TextContent{Text: currentText.String()}},
						},
						Delta: text,
					}
				}

			case "content_block_stop":
				if currentText.Len() > 0 {
					currentBlocks = append(currentBlocks, agent.TextContent{Text: currentText.String()})
					currentText.Reset()
				}
				if toolUseBuffer != nil {
					currentBlocks = append(currentBlocks, agent.ToolCallContent{
						ID:        toolUseBuffer.ID,
						Name:      toolUseBuffer.Name,
						Arguments: toolUseBuffer.Arguments,
					})
					toolUseBuffer = nil
				}

			case "message_delta":
				// Finalize message
				if currentMessage != nil {
					currentMessage.Content = currentBlocks
					currentMessage.Timestamp = timestamp
				}

			case "message_stop":
				if currentMessage != nil && len(currentMessage.Content) == 0 {
					currentMessage.Content = currentBlocks
				}
				eventCh <- agent.MessageEndEvent{
					Timestamp: timestamp,
					Message:   *currentMessage,
				}
				eventCh <- agent.TurnEndEvent{Timestamp: timestamp}
			}
		}

		if err := scanner.Err(); err != nil {
			// On error, we just close the channel
			// The caller will see an empty channel and no MessageEndEvent
		}
	}()

	return eventCh, nil
}

// Anthropic API types

type anthropicMessagesRequest struct {
	Model     string                  `json:"model"`
	MaxTokens int                     `json:"max_tokens"`
	Messages  []anthropicToolFormatFormat  `json:"messages"`
	Tools     []anthropicToolFormat      `json:"tools,omitempty"`
	Thinking  *anthropicThinkingFormatFormat  `json:"thinking,omitempty"`
	Stream    bool                    `json:"stream"`
}

type anthropicMessageFormat struct {
	Role    string `json:"role"`
	Content []any  `json:"content"`
}

type anthropicToolFormat struct {
	Name        string         `json:"name"`
	Description string         `json:"description"`
	InputSchema map[string]any `json:"input_schema"`
}

type anthropicThinkingFormat struct {
	Type         string `json:"type"`
	BudgetTokens int    `json:"budget_tokens"`
}

type anthropicToolUseBuffer struct {
	ID        string
	Name      string
	Arguments map[string]any
}
