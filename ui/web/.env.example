# Listen address of the ava binary — the dev/preview servers derive their /api
# proxy target from it (same env `just run ava` reads; empty host = all
# interfaces, proxied via localhost). Defaults to :8080, the binary's default.
# AVA_ADDR=127.0.0.1:8080

# Mock mode: serve the mock API (src/lib/mocks) from the dev/preview server — see AGENTS.md
# VITE_USE_MOCKS=true

