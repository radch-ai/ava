# Backend API URL (for agent settings, user data, etc.)
VITE_BACKEND_API_URL=http://localhost:8080

# ── E2E Test Configuration ──────────────────────────────────────────────
# E2E_* variables: values must be reachable from the Chromium container
# (the remote browser where e2e pages are rendered).

# App URL the Playwright browser opens (must be reachable from the browser environment)
E2E_APP_BASE_URL=http://localhost:4173

# Backend API URL injected into the e2e preview build as VITE_BACKEND_API_URL
E2E_BACKEND_API_URL=http://localhost:8080

# Chromium WebSocket URL for Playwright and Vitest browser tests
TEST_CHROMIUM_WS_URL=ws://localhost:9223
