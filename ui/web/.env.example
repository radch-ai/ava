# Backend API URL (for agent settings, user data, etc.)
VITE_BACKEND_API_URL=http://localhost:8080

# Mock mode: serve the deterministic mock API (src/lib/mocks) from the vite
# dev/preview server instead of a real backend. When enabled, point
# VITE_BACKEND_API_URL at the dev server itself
# (http://localhost:5173 for dev, http://localhost:4173 for preview).
# VITE_USE_MOCKS=true
#
# Mock auth: the login page accepts the token `ava-mock-token`; the session
# cookie it sets is also mock-served.

# ── E2E Test Configuration ──────────────────────────────────────────────
# E2E runs against the real backend — never mocks.

# App URL the Playwright browser opens
E2E_APP_BASE_URL=http://localhost:4173

# Backend API URL injected into the e2e preview build as VITE_BACKEND_API_URL
E2E_BACKEND_API_URL=http://localhost:8080
