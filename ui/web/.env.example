# Backend API URL baked into the app at build time; also feeds e2e preview builds
VITE_BACKEND_API_URL=http://localhost:8080

# Mock mode: serve the mock API (src/lib/mocks) from the dev/preview server — see AGENTS.md
# VITE_USE_MOCKS=true

# E2E: app URL the Playwright browser opens
E2E_APP_BASE_URL=http://localhost:4173
